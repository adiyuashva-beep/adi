<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembuat QR Code Simpel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Library QR Code JS dari CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');
        body {
            font-family: 'Poppins', sans-serif;
        }
        /* Animasi halus untuk hasil QR */
        #qrcode img {
            margin: auto;
            border: 4px solid white;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform transition-all hover:scale-[1.01]">
        
        <!-- Header -->
        <div class="bg-gray-800 p-6 text-center">
            <h1 class="text-2xl font-bold text-white tracking-wider">
                <i class="fa-solid fa-qrcode mr-2 text-pink-400"></i>QR Code Generator
            </h1>
            <p class="text-gray-400 text-sm mt-1">Buat kode scan untuk link atau teks</p>
        </div>

        <!-- Content -->
        <div class="p-6 space-y-4">
            
            <!-- Input Area -->
            <div>
                <label class="block text-gray-700 text-sm font-bold mb-2" for="text-input">
                    Masukkan Link atau Teks:
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-link text-gray-400"></i>
                    </span>
                    <input type="text" id="text-input" 
                        class="w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-purple-500 transition-colors bg-gray-50"
                        placeholder="Contoh: https://google.com atau Halo Dunia">
                </div>
                <p id="error-msg" class="text-red-500 text-xs mt-1 hidden">Mohon isi teks atau link terlebih dahulu!</p>
            </div>

            <!-- Action Button -->
            <button onclick="generateQR()" 
                class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold py-3 px-4 rounded-lg shadow-md transform transition active:scale-95 flex justify-center items-center">
                <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Buat QR Code
            </button>

            <!-- Result Area (Hidden by default) -->
            <div id="result-container" class="hidden flex-col items-center mt-6 p-4 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                <div id="qrcode" class="mb-4"></div>
                
                <div class="text-center w-full">
                    <p class="text-gray-500 text-xs mb-3">Scan kode di atas untuk membuka link</p>
                    
                    <!-- Download Button -->
                    <button id="download-btn" onclick="downloadQR()" 
                        class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors flex justify-center items-center gap-2">
                        <i class="fa-solid fa-download"></i> Download Gambar
                    </button>
                </div>
            </div>

        </div>
        
        <!-- Footer -->
        <div class="bg-gray-100 p-3 text-center text-xs text-gray-500">
            Dibuat untuk mempermudah share link WA Group
        </div>
    </div>

    <script>
        let qrcodeObj = null;

        function generateQR() {
            const input = document.getElementById('text-input');
            const inputValue = input.value.trim();
            const errorMsg = document.getElementById('error-msg');
            const resultContainer = document.getElementById('result-container');
            const qrcodeContainer = document.getElementById('qrcode');

            // Reset Error
            errorMsg.classList.add('hidden');
            input.classList.remove('border-red-500');

            // Validasi Input
            if (!inputValue) {
                errorMsg.classList.remove('hidden');
                input.classList.add('border-red-500');
                input.focus();
                return;
            }

            // Tampilkan Container Hasil
            resultContainer.classList.remove('hidden');
            resultContainer.classList.add('flex');

            // Bersihkan QR code lama jika ada
            qrcodeContainer.innerHTML = "";

            // Buat QR Code Baru
            // Menggunakan library qrcode.js
            try {
                qrcodeObj = new QRCode(qrcodeContainer, {
                    text: inputValue,
                    width: 200,
                    height: 200,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.H // High correction level biar tajam
                });
            } catch (e) {
                console.error("Gagal membuat QR Code", e);
                alert("Terjadi kesalahan sistem. Coba refresh halaman.");
            }
        }

        function downloadQR() {
            // Mencari elemen gambar di dalam div qrcode
            const qrImage = document.querySelector('#qrcode img');
            
            if (qrImage && qrImage.src) {
                // Membuat link download virtual
                const link = document.createElement('a');
                link.href = qrImage.src;
                link.download = 'QR_Code_Saya.png';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } else {
                // Fallback jika gambar belum ter-render (kadang canvas yang muncul duluan)
                const canvas = document.querySelector('#qrcode canvas');
                if(canvas) {
                    const link = document.createElement('a');
                    link.href = canvas.toDataURL("image/png");
                    link.download = 'QR_Code_Saya.png';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                } else {
                    alert('QR Code belum jadi sepenuhnya. Coba klik "Buat" lagi.');
                }
            }
        }

        // Fitur tambahan: Tekan Enter di input langsung generate
        document.getElementById('text-input').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                generateQR();
            }
        });
    </script>
</body>
</html>
